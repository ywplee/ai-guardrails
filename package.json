{
  "name": "ai-guardrails",
  "version": "1.0.0",
  "description": "Lint rules and guardrails for LLM-written code: an ESLint config plus a Claude Code plugin.",
  "main": "eslint-config.js",
  "bin": {
    "ai-guardrails": "bin/init.js"
  },
  "files": [
    "bin",
    "claude-plugin",
    "eslint-config.js",
    "GUARDRAILS.md",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslint-config",
    "claude-code",
    "llm",
    "guardrails"
  ],
  "license": "MIT",
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0"
  },
  "peerDependencies": {
    "@vitest/eslint-plugin": "^1.0.0",
    "eslint-plugin-jest": "^28.0.0",
    "eslint-plugin-n": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "@vitest/eslint-plugin": { "optional": true },
    "eslint-plugin-jest": { "optional": true },
    "eslint-plugin-n": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  }
}
